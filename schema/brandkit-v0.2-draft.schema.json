  "required": [
    "schemaVersion",
    "metadata",
    "identity",
    "positioning",
    "audiences",
    "messaging",
    "voice",
    "visualLanguage",
    "imagery",
    "products",
    "claims",
    "policies",
    "channels",
    "markets",
    "aiInstructions",
    "governance",
    "references"
